# Rename this file to .env.local, next to package.json.
# These same keys can instead be set once in the repository root .env and copied
# here by `npm run env:sync` (see the root README).
GOOGLE_MAPS_API_KEY=
# Accepted alias for the Google Maps browser key (GOOGLE_MAPS_API_KEY wins).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: traffic tiles for the map's traffic overlay.
TOMTOM_API_KEY=
# Optional: EventFlow AI backend and live updates (never replaced with fake data).
ORCHESTRATOR_URL=
ORCHESTRATOR_TOKEN=
EVENTFLOW_WS_URL=
# Optional (development only): move the local JSON store elsewhere.
EVENTFLOW_DATA_DIR=
