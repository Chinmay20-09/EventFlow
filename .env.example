[TEMPLATE]
# EventFlow environment template — root of the repository.
# Copy to `.env` (git-ignored) and fill in the values you use. Never commit `.env`.
# Every variable is OPTIONAL; each app shows an honest disconnected state until
# the service it needs is configured.
#
# When both apps need the same key (for example the Google Maps browser key),
# put it here ONCE and run `npm run env:sync`: the shared keys below are copied
# into frontend-ideal/.env.local and frontend/.env.local. The sync also runs
# automatically before `npm run dev` and `npm run test`. Empty values are not
# synced, so a per-app override is never overwritten.
#
# The root Vite app reads this file directly. Only variables prefixed with
# VITE_ are exposed to browser code, so keep secrets unprefixed.

# ---------------------------------------------------------------------------
# SHARED API KEYS — synced to frontend-ideal/.env.local and frontend/.env.local
# ---------------------------------------------------------------------------

# Google Maps browser key (also accepted as NEXT_PUBLIC_GOOGLE_MAPS_API_KEY).
# Restrict it to the Maps JavaScript API and your origins (http://localhost:3000/*).
# GOOGLE_MAPS_API_KEY=

# Traffic tiles for the map's traffic overlay (server-side only).
# TOMTOM_API_KEY=

# EventFlow AI/orchestrator backend and live crowd updates. API tokens stay
# server-side; never expose them to the browser.
# ORCHESTRATOR_URL=
# ORCHESTRATOR_TOKEN=
# EVENTFLOW_WS_URL=

# Optional: move the local JSON store of frontend-ideal elsewhere (development only).
# EVENTFLOW_DATA_DIR=

# ---------------------------------------------------------------------------
# ROOT VITE APP (weather digital twin) — used directly from this file
# ---------------------------------------------------------------------------

# LIVE SOCIAL SIGNALS — public Mastodon hashtag timeline (real, key-less, CORS `*`).
# Verified reachable from the browser (2026-09). To use a team-hosted
# RSS-to-JSON bridge instead, set VITE_SOCIAL_SIGNALS_URL (it takes priority).
# VITE_SOCIAL_SIGNALS_URL=

# Weather provider override (defaults to Open-Meteo, which needs no key).
# VITE_WEATHER_API_URL=
# VITE_WEATHER_API_KEY=

# Venue coordinates (default = demo venue, Mumbai).
# VITE_VENUE_LAT=19.076
# VITE_VENUE_LON=72.8777
