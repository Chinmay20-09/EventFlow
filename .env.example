# Weather digital-twin configuration (midnight task) — root env template.
# Copy to `.env` and fill in real values. Never commit `.env`.
# All variables are OPTIONAL — the digital twin works with defaults.

# Optional weather provider override (defaults to Open-Meteo, which needs no key).
# VITE_WEATHER_API_URL=
# VITE_WEATHER_API_KEY=

# Venue coordinates (default = demo venue, Mumbai).
# VITE_VENUE_LAT=19.076
# VITE_VENUE_LON=72.8777

# Optional live social/public signal feed (RSS-to-JSON bridge).
# Unset = public Mastodon weather timeline (real, key-less, CORS `*`);
# only if that also fails, a clearly-labelled demo feed is served
# (see docs/Weather_Digital_Twin.md §8).
# VITE_SOCIAL_SIGNALS_URL=
