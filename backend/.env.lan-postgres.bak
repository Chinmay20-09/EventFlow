# EventFlow P3 backend configuration (EV-029).
# Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string.
# `postgresql+psycopg://` uses the psycopg3 driver required by requirements.txt.
DATABASE_URL=postgresql+psycopg://eventflow:EventFlow123@192.168.137.97:5432/eventflow

API_HOST=0.0.0.0
API_PORT=8000

ENVIRONMENT=development

# EV-015 §7 / EV-029 §4 — MVP default is 2.
MAX_SIMULATION_ATTEMPTS=2

# Shared P1→P3 service key (P1_BACKEND_INTEGRATION_REQUIREMENTS §14).
# When set, /api/internal/* requires `Authorization: Bearer <value>`.
# The P1 transport (src/transport) must carry the SAME value in P3_API_KEY.
# Empty = authentication disabled (development default). Never commit a real key.
P3_API_KEY=

# JWT bearer token signing key (EV-029).
# Generated as a strong local development secret; NEVER commit.
SECRET_KEY=mdrWvrXYp4Hudxdv3r9v9a3YDddXxnq09kLdtbt2gTc5FjGB1vcxQxmjUDDh0WMB
