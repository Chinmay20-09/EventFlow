# EventFlow P3 backend configuration (EV-029).
# Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string.
# `postgresql+psycopg://` uses the psycopg3 driver required by requirements.txt.
DATABASE_URL=postgresql+psycopg://eventflow:change_me@localhost:5432/eventflow

API_HOST=0.0.0.0
API_PORT=8000

ENVIRONMENT=development

# EV-015 §7 / EV-029 §4 — MVP default is 2.
MAX_SIMULATION_ATTEMPTS=2
