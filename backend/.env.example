# EventFlow P3 backend configuration (EV-029).
# Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string.
# `postgresql+psycopg://` uses the psycopg3 driver required by requirements.txt.
DATABASE_URL=postgresql+psycopg://eventflow:EventFlow123@localhost:5432/eventflow

API_HOST=0.0.0.0
API_PORT=8000

ENVIRONMENT=development

# EV-015 §7 / EV-029 §4 — MVP default is 2.
MAX_SIMULATION_ATTEMPTS=2

# JWT signing key for user authentication (POST /api/auth/login).
# REQUIRED in production (startup fails without it outside development/test).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Access-token lifetime in minutes (default 60).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared P1→P3 service key for /api/internal/* (optional; empty = disabled).
P3_API_KEY=

# P1 engine execution mode for POST /strategy-sets/{id}/simulate.
# "real" (default): run the deterministic TypeScript engine (engine/src)
#   through integration/runner/p1Runner.ts via the local Node runtime; if
#   Node/tsx is unavailable the adapter degrades to the marked mock.
# "mock": force the clearly-marked placeholder (no Node required).
P1_ENGINE_MODE=real
